@import "../../../uvue.wxss";
:host{display:flex;flex-direction:column}

.login-container[class] {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 60rpx;
		min-height: 100vh;
		background-color: #f8f8f8;
}
.login-title[class] {
		margin-top: 160rpx;
		margin-bottom: 100rpx;
}
.login-title[class] text {
		font-size: 48rpx;
		font-weight: bold;
		color: #333;
}
.login-form[class] {
		width: 100%;
}
.form-item[class] {
		display: flex;
		flex-direction: column;
		margin-bottom: 40rpx;
}
.label[class] {
		font-size: 28rpx;
		color: #666;
		margin-bottom: 16rpx;
}
.input[class] {
		height: 88rpx;
		padding: 0 24rpx;
		border: 1rpx solid #ddd;
		border-radius: 12rpx;
		background-color: #fff;
		font-size: 28rpx;
}
.login-btn[class] {
		margin-top: 60rpx;
		width: 100%;
		height: 88rpx;
		line-height: 88rpx;
		border-radius: 12rpx;
		font-size: 32rpx;
}